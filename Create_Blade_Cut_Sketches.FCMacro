import FreeCAD as App
import Part
import Sketcher

doc = App.ActiveDocument

body = doc.addObject("PartDesign::Body", "Body")

planes_and_splines = [
    (-935.0, [(-42.5, 57.8), (4.0, 151.0), (24.7, 198.2), (17.8, 260.2), (-28.7, 321.8), (-81.5, 377.3), (-98.1, 388.0)]),
    (-1200.0, [(5.0, 74.8), (29.3, 195.2), (13.0, 238.6), (-24.6, 287.8), (-62.1, 326.2), (-107.4, 354.8), (-131.0, 367.5)]),
    (-1400.0, [(36.9, 140.6), (41.8, 183.4), (10.0, 250.9), (-40.0, 287.4), (-78.9, 312.0), (-131.6, 339.3), (-147.3, 346.6)]),
    (-1600.0, [(69.6, 165.5), (57.5, 202.0), (21.6, 231.2), (-34.0, 271.8), (-104.1, 304.7), (-151.0, 323.2), (-170.7, 331.5)]),
    (-1800.0, [(110.8, 175.9), (85.1, 202.2), (19.6, 236.5), (-26.5, 258.0), (-112.4, 290.5), (-167.3, 307.9), (-187.0, 313.5)]),
    (-1900.0, [(127.8, 188.5), (90.6, 206.0), (30.5, 234.5), (-16.9, 251.6), (-90.7, 276.5), (-155.1, 295.5), (-175.0, 300.7), (-190.0, 305.7)]),
    (-2000.0, [(140.1, 199.1), (104.5, 209.6), (44.4, 231.3), (-23.0, 251.9), (-110.1, 276.7), (-176.4, 293.2), (-210.4, 301.8)]),
    (-2100.0, [(152.2, 207.2), (135.1, 212.3), (44.2, 233.0), (-23.9, 249.7), (-93.7, 266.7), (-189.4, 289.1), (-235.3, 299.5)]),
    (-2200.0, [(161.8, 215.8), (134.6, 220.1), (44.0, 235.6), (-52.9, 254.5), (-153.0, 273.9), (-195.0, 283.2), (-215.7, 287.9)]),
    (-2250.0, [(178.1, 215.7), (157.8, 218.2), (117.8, 224.4), (10.1, 240.9), (-107.8, 264.3), (-205.2, 283.8), (-241.5, 291.1)])
]

yz_plane = doc.getObject("YZ_Plane")

for idx, (z_offset, pts) in enumerate(planes_and_splines):
    plane_name = "DatumPlane" if idx == 0 else f"DatumPlane{idx:03d}"
    sketch_name = "Sketch" if idx == 0 else f"Sketch{idx:03d}"


    dp = body.newObject("PartDesign::Plane", plane_name)
    dp.AttachmentSupport = [(yz_plane, "")]
    dp.MapMode = "FlatFace"
    dp.AttachmentOffset = App.Placement(App.Vector(0, 0, z_offset), App.Rotation())


    sk = body.newObject("Sketcher::SketchObject", sketch_name)
    sk.AttachmentSupport = [(dp, "")]
    sk.MapMode = "FlatFace"

    poles = [App.Vector(x, y, 0.0) for x, y in pts]
    bspline = Part.BSplineCurve()
    bspline.buildFromPoles(poles)
    sk.addGeometry(bspline, False)

doc.recompute()
